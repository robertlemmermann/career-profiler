{
  "schema": "career-pii-detectors/1",
  "note": "Patterns applied to anything that leaves the store (drafts, finals, exports, board queries, notifications) and to incoming fact text. severity block stops finalize/export; review is reported for a human decision. Flags are JavaScript regex flags. Profiles name the artifacts a detector applies to; an empty list means all.",
  "detectors": [
    {
      "id": "ssn-us",
      "label": "US Social Security number",
      "pattern": "\\b(?!000|666|9\\d{2})\\d{3}-(?!00)\\d{2}-(?!0000)\\d{4}\\b",
      "severity": "block",
      "profiles": []
    },
    {
      "id": "sin-ca",
      "label": "Canadian SIN",
      "pattern": "\\b\\d{3}[- ]\\d{3}[- ]\\d{3}\\b(?=.{0,20}\\b(?:SIN|social insurance)\\b)|\\b(?:SIN|social insurance)\\b.{0,20}\\b\\d{3}[- ]?\\d{3}[- ]?\\d{3}\\b",
      "flags": "i",
      "severity": "block",
      "profiles": []
    },
    {
      "id": "nino-uk",
      "label": "UK National Insurance number",
      "pattern": "\\b[A-CEGHJ-PR-TW-Z]{2}\\s?\\d{2}\\s?\\d{2}\\s?\\d{2}\\s?[A-D]\\b",
      "severity": "block",
      "profiles": []
    },
    {
      "id": "national-id-label",
      "label": "a national id, passport or tax number given with its label",
      "pattern": "\\b(?:passport|national id|identity card|tax id|tin|steuer-?id|nie|dni|aadhaar|pan card|cpf|curp|codice fiscale)\\b\\s*(?:number|no\\.?|#|:|is)?\\s*[:#]?\\s*(?=[A-Z0-9 -]{0,12}\\d{3})[A-Z0-9][A-Z0-9 -]{5,}\\b",
      "flags": "i",
      "severity": "block",
      "profiles": []
    },
    {
      "id": "dob",
      "label": "date of birth",
      "pattern": "\\b(?:date of birth|born(?: on)?|birth ?date|dob|d\\.o\\.b\\.?)\\b[^\\n]{0,25}?\\b(?:\\d{1,2}[/.-]\\d{1,2}[/.-]\\d{2,4}|\\d{4}-\\d{2}-\\d{2}|(?:jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)[a-z]*\\.? \\d{1,2},? \\d{4}|\\d{1,2} (?:jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)[a-z]* \\d{4})",
      "flags": "i",
      "severity": "block",
      "profiles": []
    },
    {
      "id": "age",
      "label": "age stated",
      "pattern": "\\b(?:i am|i'm|aged?)\\s+\\d{2}\\s+years? old\\b|\\b\\d{2}-year-old\\b",
      "flags": "i",
      "severity": "block",
      "profiles": [
        "resume",
        "cover",
        "export"
      ]
    },
    {
      "id": "street-address",
      "label": "street address",
      "pattern": "\\b\\d{1,5}[a-z]?\\s+(?:[A-Z][a-z]+\\s){0,3}(?:street|st\\.|avenue|ave\\.?|road|rd\\.?|boulevard|blvd\\.?|lane|ln\\.?|drive|dr\\.?|court|ct\\.?|way|place|pl\\.?|terrace|straße|strasse|platz)\\b(?:[ ,]+(?:apt|suite|unit|#)\\s*\\w+)?",
      "flags": "i",
      "severity": "block",
      "profiles": [
        "resume",
        "cover",
        "export",
        "board",
        "log"
      ]
    },
    {
      "id": "postal-code-full",
      "label": "a postal code with a street address",
      "pattern": "\\b(?:street|st\\.|avenue|ave\\.?|road|rd\\.?)\\b[^\\n]{0,40}\\b(?:\\d{5}(?:-\\d{4})?|[A-Z]\\d[A-Z] ?\\d[A-Z]\\d|[A-Z]{1,2}\\d[A-Z\\d]? ?\\d[A-Z]{2})\\b",
      "flags": "i",
      "severity": "review",
      "profiles": [
        "resume",
        "cover",
        "export"
      ]
    },
    {
      "id": "iban",
      "label": "IBAN",
      "pattern": "\\b[A-Z]{2}\\d{2}(?:[ ]?[A-Z0-9]{4}){3,7}(?:[ ]?[A-Z0-9]{1,4})?\\b",
      "severity": "block",
      "profiles": []
    },
    {
      "id": "card-number",
      "label": "payment card number",
      "pattern": "\\b(?:\\d[ -]*?){13,19}\\b",
      "severity": "block",
      "profiles": [],
      "luhn": true
    },
    {
      "id": "bank-label",
      "label": "bank account details",
      "pattern": "\\b(?:routing number|account number|sort code|swift|bic)\\b[^\\n]{0,20}\\d{4,}",
      "flags": "i",
      "severity": "block",
      "profiles": []
    },
    {
      "id": "marital-family",
      "label": "marital or family status",
      "pattern": "\\b(?:married|single|divorced|widowed|separated|my (?:wife|husband|spouse|partner)|mother of|father of|\\d+ (?:kids|children)|pregnant|maternity leave|paternity leave)\\b",
      "flags": "i",
      "severity": "review",
      "profiles": [
        "resume",
        "cover",
        "export"
      ]
    },
    {
      "id": "religion",
      "label": "religion or belief",
      "pattern": "\\b(?:christian|catholic|protestant|muslim|jewish|hindu|buddhist|sikh|atheist|church member|mosque|synagogue|temple attendance)\\b",
      "flags": "i",
      "severity": "review",
      "profiles": [
        "resume",
        "cover",
        "export"
      ]
    },
    {
      "id": "health",
      "label": "health, disability or medical condition about the candidate",
      "pattern": "\\b(?:my (?:disability|diagnosis|condition|illness|medication|therapy|surgery)|i (?:have|was diagnosed with|suffer from) (?:[a-z]+ ){0,2}(?:disorder|disease|cancer|diabetes|depression|anxiety|adhd|autism|epilepsy|ptsd|ms)\\b|sick leave|medical leave|disability leave)",
      "flags": "i",
      "severity": "review",
      "profiles": [
        "resume",
        "cover",
        "export"
      ]
    },
    {
      "id": "ethnicity",
      "label": "ethnicity, nationality or citizenship stated as a personal attribute",
      "pattern": "\\b(?:nationality|ethnicity|citizenship|race)\\s*[:\\-]\\s*[A-Za-z]+",
      "flags": "i",
      "severity": "review",
      "profiles": [
        "resume",
        "cover",
        "export"
      ]
    },
    {
      "id": "photo",
      "label": "a photo",
      "pattern": "!\\[[^\\]]*\\]\\([^)]*\\.(?:jpe?g|png|gif|webp)\\)|\\b(?:photo|headshot|picture) (?:attached|enclosed|below)\\b",
      "flags": "i",
      "severity": "review",
      "profiles": [
        "resume",
        "cover"
      ]
    },
    {
      "id": "secret-token",
      "label": "an API key or token",
      "pattern": "\\b(?:sk-[A-Za-z0-9]{20,}|ghp_[A-Za-z0-9]{30,}|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{10,})\\b",
      "severity": "block",
      "profiles": []
    },
    {
      "id": "extra-email",
      "label": "an email address that is not the chosen contact email",
      "pattern": "[\\w.+-]+@[\\w-]+\\.[\\w.-]+",
      "severity": "review",
      "profiles": [
        "resume",
        "cover",
        "export",
        "board",
        "log"
      ],
      "allow": "contact"
    },
    {
      "id": "extra-phone",
      "label": "a phone number that is not the chosen contact phone",
      "pattern": "(?<![\\w/.-])(?:\\+?\\d{1,3}[ .-]?)?(?:\\(\\d{2,4}\\)[ .-]?|\\d{2,4}[ .-])\\d{3,4}[ .-]?\\d{3,4}(?![\\w/-]|\\.\\d)",
      "severity": "review",
      "profiles": [
        "resume",
        "cover",
        "export",
        "board",
        "log"
      ],
      "allow": "contact"
    }
  ],
  "never_asked": [
    "date of birth",
    "age",
    "national identity, passport, tax or social security numbers",
    "street address",
    "marital or family status",
    "religion or belief",
    "health, disability or medical history",
    "ethnicity, nationality or citizenship as an attribute",
    "a photo",
    "bank or payment details"
  ]
}
