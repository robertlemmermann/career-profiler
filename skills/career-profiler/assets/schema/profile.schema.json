{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/robertlemmermann/career-profiler/skills/career-profiler/assets/schema/profile.schema.json",
  "title": "career-profile/1",
  "description": "The career-profiler fact store. Written only by scripts/cp.mjs (or by hand followed by `store accept`). Every list entry carries an id and a provenance; only confirmed entries may appear in a resume. Dates are YYYY, YYYY-MM or YYYY-MM-DD; a null or missing `end` means present.",
  "type": "object",
  "required": ["schema", "meta", "identity", "targets", "summary", "experience", "education", "certifications", "skills", "projects", "publications", "awards", "volunteering", "languages", "extras", "documents"],
  "properties": {
    "schema": { "const": "career-profile/1" },
    "meta": { "type": "object", "properties": { "created": { "type": "string" }, "updated": { "type": "string" }, "generated_by": { "type": "string" }, "locale": { "type": "string" }, "sequence": { "type": "integer" }, "interview": { "type": "object", "properties": { "asked": { "type": "array", "items": { "type": "string" } } } } } },
    "identity": { "type": "object", "properties": { "name": { "type": "string" }, "headline": { "type": "string" }, "email": { "type": "string" }, "phone": { "type": "string" }, "location": { "type": "object", "properties": { "city": { "type": "string" }, "region": { "type": "string" }, "country": { "type": "string" } } }, "links": { "type": "array", "items": { "type": "object", "required": ["url"], "properties": { "label": { "type": "string" }, "url": { "type": "string" } } } }, "work_authorization": { "type": "string" }, "relocation": { "type": "string" }, "remote_preference": { "type": "string" }, "pronouns": { "type": "string" }, "provenance": { "$ref": "#/$defs/provenance" } } },
    "targets": { "type": "object", "properties": { "roles": { "type": "array", "items": { "type": "string" } }, "industries": { "type": "array", "items": { "type": "string" } }, "seniority": { "type": "string" }, "locations": { "type": "array", "items": { "type": "string" } }, "compensation": { "type": "string" }, "notes": { "type": "string" }, "provenance": { "$ref": "#/$defs/provenance" } } },
    "summary": { "type": "object", "properties": { "pitch": { "type": "string" }, "strengths": { "type": "array", "items": { "type": "string" } }, "notes": { "type": "string" }, "provenance": { "$ref": "#/$defs/provenance" } } },
    "experience": { "type": "array", "items": { "$ref": "#/$defs/experience" } },
    "education": { "type": "array", "items": { "type": "object", "required": ["id", "institution", "provenance"], "properties": { "id": { "type": "string", "pattern": "^edu-" }, "institution": { "type": "string" }, "degree": { "type": "string" }, "field": { "type": "string" }, "start": { "$ref": "#/$defs/date" }, "end": { "$ref": "#/$defs/date" }, "honors": { "type": "string" }, "location": { "type": "string" }, "coursework": { "type": "array", "items": { "type": "string" } }, "notes": { "type": "string" }, "provenance": { "$ref": "#/$defs/provenance" } } } },
    "certifications": { "type": "array", "items": { "type": "object", "required": ["id", "name", "provenance"], "properties": { "id": { "type": "string", "pattern": "^cert-" }, "name": { "type": "string" }, "issuer": { "type": "string" }, "date": { "$ref": "#/$defs/date" }, "expires": { "$ref": "#/$defs/date" }, "id_number": { "type": "string" }, "url": { "type": "string" }, "notes": { "type": "string" }, "provenance": { "$ref": "#/$defs/provenance" } } } },
    "skills": { "type": "array", "items": { "type": "object", "required": ["id", "name", "provenance"], "properties": { "id": { "type": "string", "pattern": "^skill-" }, "name": { "type": "string" }, "category": { "type": "string" }, "level": { "enum": ["beginner", "intermediate", "advanced", "expert"] }, "years": { "type": "number", "minimum": 0 }, "last_used": { "type": "string" }, "evidence": { "type": "array", "items": { "type": "string" }, "description": "achievement, project or certification ids that show the skill in use" }, "aliases": { "type": "array", "items": { "type": "string" } }, "notes": { "type": "string" }, "provenance": { "$ref": "#/$defs/provenance" } } } },
    "projects": { "type": "array", "items": { "type": "object", "required": ["id", "name", "provenance"], "properties": { "id": { "type": "string", "pattern": "^proj-" }, "name": { "type": "string" }, "role": { "type": "string" }, "start": { "$ref": "#/$defs/date" }, "end": { "$ref": "#/$defs/date" }, "url": { "type": "string" }, "summary": { "type": "string" }, "stack": { "type": "array", "items": { "type": "string" } }, "outcomes": { "type": "array", "items": { "type": "string" } }, "metrics": { "type": "array", "items": { "$ref": "#/$defs/metric" } }, "skills": { "type": "array", "items": { "type": "string" } }, "notes": { "type": "string" }, "provenance": { "$ref": "#/$defs/provenance" } } } },
    "publications": { "type": "array", "items": { "type": "object", "required": ["id", "title", "provenance"], "properties": { "id": { "type": "string", "pattern": "^pub-" }, "title": { "type": "string" }, "venue": { "type": "string" }, "date": { "$ref": "#/$defs/date" }, "url": { "type": "string" }, "role": { "type": "string" }, "notes": { "type": "string" }, "provenance": { "$ref": "#/$defs/provenance" } } } },
    "awards": { "type": "array", "items": { "type": "object", "required": ["id", "name", "provenance"], "properties": { "id": { "type": "string", "pattern": "^award-" }, "name": { "type": "string" }, "issuer": { "type": "string" }, "date": { "$ref": "#/$defs/date" }, "notes": { "type": "string" }, "provenance": { "$ref": "#/$defs/provenance" } } } },
    "volunteering": { "type": "array", "items": { "type": "object", "required": ["id", "organization", "provenance"], "properties": { "id": { "type": "string", "pattern": "^vol-" }, "organization": { "type": "string" }, "role": { "type": "string" }, "start": { "$ref": "#/$defs/date" }, "end": { "$ref": "#/$defs/date" }, "summary": { "type": "string" }, "outcomes": { "type": "array", "items": { "type": "string" } }, "notes": { "type": "string" }, "provenance": { "$ref": "#/$defs/provenance" } } } },
    "languages": { "type": "array", "items": { "type": "object", "required": ["id", "name", "provenance"], "properties": { "id": { "type": "string", "pattern": "^lang-" }, "name": { "type": "string" }, "level": { "enum": ["basic", "conversational", "professional", "fluent", "native"] }, "notes": { "type": "string" }, "provenance": { "$ref": "#/$defs/provenance" } } } },
    "extras": { "type": "array", "items": { "type": "object", "required": ["id", "text", "provenance"], "properties": { "id": { "type": "string", "pattern": "^fact-" }, "text": { "type": "string" }, "tags": { "type": "array", "items": { "type": "string" } }, "notes": { "type": "string" }, "provenance": { "$ref": "#/$defs/provenance" } } } },
    "documents": { "type": "array", "items": { "type": "object", "required": ["id", "path", "provenance"], "properties": { "id": { "type": "string", "pattern": "^doc-" }, "path": { "type": "string" }, "kind": { "type": "string" }, "added": { "$ref": "#/$defs/date" }, "notes": { "type": "string" }, "provenance": { "$ref": "#/$defs/provenance" } } } }
  },
  "$defs": {
    "date": { "type": ["string", "null"], "pattern": "^(\\d{4}(-\\d{2}(-\\d{2})?)?|[Pp]resent)?$" },
    "provenance": { "type": "object", "required": ["source", "confirmed"], "properties": { "source": { "enum": ["interview", "document", "user", "import"] }, "confirmed": { "type": "boolean", "description": "true only after the user confirmed the fact in conversation; unconfirmed facts never reach a resume" }, "at": { "type": "string" }, "note": { "type": "string" } } },
    "metric": { "type": "object", "required": ["value", "label"], "properties": { "value": { "type": ["number", "string"] }, "unit": { "type": "string" }, "label": { "type": "string" } } },
    "achievement": { "type": "object", "required": ["id", "text", "provenance"], "properties": { "id": { "type": "string", "pattern": "^ach-" }, "text": { "type": "string", "description": "one result-oriented sentence: what you did and what changed" }, "situation": { "type": "string" }, "task": { "type": "string" }, "action": { "type": "string" }, "result": { "type": "string" }, "metrics": { "type": "array", "items": { "$ref": "#/$defs/metric" } }, "skills": { "type": "array", "items": { "type": "string" } }, "tags": { "type": "array", "items": { "type": "string" } }, "notes": { "type": "string" }, "provenance": { "$ref": "#/$defs/provenance" } } },
    "experience": { "type": "object", "required": ["id", "employer", "title", "start", "provenance"], "properties": { "id": { "type": "string", "pattern": "^exp-" }, "employer": { "type": "string" }, "title": { "type": "string", "description": "the exact title held; never inflated for a posting" }, "start": { "$ref": "#/$defs/date" }, "end": { "$ref": "#/$defs/date" }, "location": { "type": "string" }, "type": { "enum": ["full-time", "part-time", "contract", "freelance", "internship", "volunteer", "self-employed", "other"] }, "industry": { "type": "string" }, "team_size": { "type": ["integer", "string"] }, "reports": { "type": ["integer", "string"] }, "scope": { "type": "string" }, "stack": { "type": "array", "items": { "type": "string" }, "description": "tools, technologies, systems, equipment or methods used in the role" }, "responsibilities": { "type": "array", "items": { "type": "string" } }, "achievements": { "type": "array", "items": { "$ref": "#/$defs/achievement" } }, "notes": { "type": "string" }, "provenance": { "$ref": "#/$defs/provenance" } } }
  }
}
